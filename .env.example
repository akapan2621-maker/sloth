# ---------------------------------------------------------------------------
# AI Workspace - environment configuration
# Copy to `.env.local` and fill in the values you need.
# Every value is OPTIONAL: the app runs fully client-side without any of them.
# ---------------------------------------------------------------------------

# Kilo Code AI Gateway (OpenAI-compatible). Used as the server-side fallback
# when the browser does not supply its own key (e.g. shared deployments).
KILO_API_KEY=
KILO_BASE_URL=https://api.kilocode.ai/v1

# Default model id used when the browser has not picked one yet.
KILO_MODEL_ID=anthropic/claude-3.7-sonnet

# Supabase (free tier) - enables cloud sync + pgvector hybrid retrieval.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: server-side only service role key, used for privileged writes.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Google AI Studio key enabling `text-embedding-004` vector mode
# when the Kilo Code gateway does not expose an /embeddings endpoint.
GEMINI_API_KEY=
